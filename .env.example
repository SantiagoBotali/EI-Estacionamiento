# ============================================================
# .env.example — EI-Estacionamiento
# Copiá este archivo a .env y completá los valores reales.
# ============================================================

# ── Seguridad JWT ────────────────────────────────────────────
SECRET_KEY=changeme-super-secret-key-for-jwt-signing

# ── Base de datos ────────────────────────────────────────────
# (La ruta por defecto es parking.db en la raíz del proyecto)
# DATABASE_URL=sqlite:///./parking.db

# ─────────────────────────────────────────────────────────────
# MercadoPago — Checkout Pro
# ---------------------------------------------------------
# Cómo obtener estas credenciales:
#   1. Entrá a https://www.mercadopago.com.ar/developers/panel
#   2. Panel de desarrollador → Tus aplicaciones → (Seleccioná o creá una app)
#   3. Credenciales de prueba / Credenciales de producción
#      → copiá el Access Token
# ─────────────────────────────────────────────────────────────

# Access Token (empieza con APP_USR- en producción o TEST- en sandbox)
MP_ACCESS_TOKEN=REEMPLAZAME_CON_TU_ACCESS_TOKEN

# Clave secreta del Webhook (se genera al REGISTRAR el webhook en el panel):
#   Panel → Webhooks → Agregar → configurar URL → MP genera el secret
MP_WEBHOOK_SECRET=REEMPLAZAME_CON_TU_WEBHOOK_SECRET

# URL HTTPS pública de tu backend que MercadoPago usará para enviar notificaciones.
# DEBE ser HTTPS. En desarrollo local, usá ngrok:
#   ngrok http 8000
#   → copiá la URL que te da ngrok, ej: https://abc123.ngrok-free.app
# Dejá el path /api/payments/mp/webhook al final (MP concatena el end_point)
MP_URL_BACKEND=https://TU_DOMINIO_O_NGROK.ngrok-free.app/api/payments/mp/webhook

# URL a la que MP redirige al usuario tras un pago APROBADO.
# El backend agrega /{stay_id} al final.
MP_URL_FRONTEND_SUCCESS=http://localhost:5173/pago/exito

# URL a la que MP redirige si el pago FALLA o está PENDIENTE.
MP_URL_FRONTEND_FAILURE=http://localhost:5173/pago/error

# Minutos antes de que el cron cancele estadías PAYMENT_PENDING sin pago (default: 30)
MP_TIME=30

# ─────────────────────────────────────────────────────────────
# Cómo registrar el Webhook en el panel de MercadoPago
# ─────────────────────────────────────────────────────────────
# 1. Panel de desarrollador → Webhooks (menú lateral)
# 2. "Agregar webhook" o "Configurar notificaciones"
# 3. URL: https://TU_BACKEND/api/payments/mp/webhook/estadia
#         ↑ Asegurate de que sea HTTPS y esté publicada (ngrok en dev)
# 4. Eventos a suscribir: "Pagos" (payment)
# 5. Al guardar, MP te muestra el "Signing secret" → eso es tu MP_WEBHOOK_SECRET
# 6. Copiá ese secret al .env y reiniciá el servidor.
#
# Para testing: desde el panel podés enviar una "notificación de prueba"
# al endpoint. El sistema la acepta y la logea (data_id=123456 es ignorado).
# ─────────────────────────────────────────────────────────────
